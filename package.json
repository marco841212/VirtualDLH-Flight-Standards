{
  "name": "virtualdlh-flight-standards",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "VirtualDLH Stratos Cockpit Standards Plugin",
  "scripts": {
    "build": "tsc",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test": "tsc --noEmit && npm run test:phase && npm run test:phase-precedence && npm run test:lights && npm run test:phases",
    "test:phase": "npm run build && node dist/tests/phaseDetector.test.js",
    "test:phase-precedence": "npm run build && node dist/tests/phasePrecedence.test.js",
    "test:flight": "npm run build && node dist/tests/normalFlight.test.js",
    "test:hardlanding": "npm run build && node dist/tests/hardLanding.test.js",
    "test:unstable": "npm run build && node dist/tests/unstableApproach.test.js",
    "test:overspeed": "npm run build && node dist/tests/overspeed.test.js",
    "test:sinkrate": "npm run build && node dist/tests/sinkRate.test.js",
    "test:approach": "npm run build && node dist/tests/approach.test.js",
    "test:landing": "npm run build && node dist/tests/landing.test.js",
    "test:lights": "npm run build && node dist/tests/lightTelemetry.test.js",
    "test:phases": "npm run build && node dist/tests/phaseReports.test.js",
    "test:stratos-integration": "npm run build && node dist/tests/stratosIntegration.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@skyvexsoftware/stratos-sdk": "^0.16.5",
    "dotenv": "^17.4.2"
  }
}
